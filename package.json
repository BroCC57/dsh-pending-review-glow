{
  "name": "dsh-pending-review-glow",
  "version": "0.2.0",
  "description": "Highlights DSH sidebar session rows by state: pending approval, running, just finished.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BroCC57/dsh-pending-review-glow.git"
  },
  "homepage": "https://github.com/BroCC57/dsh-pending-review-glow#readme",
  "bugs": {
    "url": "https://github.com/BroCC57/dsh-pending-review-glow/issues"
  },
  "author": "BroCC57",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "approval"
  ],
  "license": "MIT"
}
